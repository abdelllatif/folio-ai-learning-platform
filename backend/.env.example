# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# E-mail (console backend prints reset links in the terminal during development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Folio <no-reply@folio.ma>

# Database (PostgreSQL). Set USE_SQLITE=1 for a quick local run without Postgres.
USE_SQLITE=0
POSTGRES_DB=folio
POSTGRES_USER=folio
POSTGRES_PASSWORD=folio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT lifetimes (minutes / days)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=600

# Embeddings (Sentence-Transformers, multilingual for FR/EN/AR courses)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Set to 1 to use the lightweight hashing embedder (no torch download) — dev/CI only
EMBEDDING_LIGHT=0

# OCR (Tesseract) — languages installed on the machine
OCR_ENABLED=1
OCR_LANGUAGES=fra+eng

# Background processing: 1 = run the pipeline inline (tests), 0 = worker thread
TASKS_EAGER=0

# Free plan limits (business rules)
FREE_PLAN_MAX_DOCUMENTS=15
FREE_PLAN_MAX_FILE_MB=25
PRO_PLAN_MAX_FILE_MB=100
